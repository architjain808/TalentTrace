{
  "expo": {
    "name": "TalentTrace",
    "slug": "hr-email-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-dark.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hr-email-finder",
    "splash": {
      "image": "./assets/logo-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/logo-dark.png"
      },
      "package": "com.talenttrace.app",
      "googleServicesFile": "./app/google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "hr-email-finder"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo-dark.png",
      "bundler": "metro",
      "output": "server"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "react-native-iap"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50e18649-5b6c-48c8-aa08-da4dc42c8c8b"
      }
    }
  }
}
