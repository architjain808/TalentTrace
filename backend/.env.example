# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Add your production domain when deploying.
CORS_ORIGIN=http://localhost:8081,http://10.0.2.2:8081

# ─── Firebase Admin ───────────────────────────────────────────────────────────
# Path to your Firebase service account JSON key.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ─── Google Play Developer API ────────────────────────────────────────────────
# Path to your Google Play service account JSON key.
# Create at: Play Console → Setup → API Access → Create service account
# Grant the service account "Financial data" and "Order management" permissions in Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./play-service-account.json

# Your app's Android package name (from app.json → android.package)
GOOGLE_PLAY_PACKAGE_NAME=com.talenttrace.app
